#!/bin/sh
echo "Welcome to fake claude"
echo '{"type":"system","subtype":"init"}'
if [ "$HANG" = "1" ]; then exec sleep 60; fi
read -r line
id=$(printf '%s' "$line" | sed -n 's/.*"request_id":"\([^"]*\)".*/\1/p')
printf '{"type":"control_response","response":{"subtype":"success","request_id":"%s","response":{"subscription_type":"max","config_dir":"%s","rate_limits":{"limits":[]}}}}\n' "$id" "${CLAUDE_CONFIG_DIR-<unset>}"
exec sleep 60
