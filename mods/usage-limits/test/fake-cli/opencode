#!/bin/sh
here=$(dirname "$0")
if [ "$1" = "auth" ] && [ "$2" = "export" ] && [ "$3" = "opencode-go" ]; then
  [ "$FAKE_OPENCODE" != fail ] || { echo "boom" >&2; exit 1; }
  [ "$FAKE_OPENCODE_GO_EMPTY" != 1 ] || { printf '%s\n' '[]'; exit 0; }
  printf '%s\n' '[{"active":false,"key":"inactive-fake-key"},{"active":true,"key":"active-fake-key"}]'
  exit 0
fi
if [ "$1" = "auth" ] && [ "$2" = "export" ] && [ "$3" = "opencode" ]; then
  [ "$FAKE_OPENCODE" != fail ] || { echo "boom" >&2; exit 1; }
  [ "$FAKE_OPENCODE_OAUTH" = 1 ] || { printf '%s\n' '[]'; exit 0; }
  printf '%s\n' '[{"active":true,"value":{"type":"oauth","access":"active-oauth-token"}}]'
  exit 0
fi
days=
while [ $# -gt 0 ]; do
  if [ "$1" = "--days" ]; then days=$2; fi
  shift
done
case "$FAKE_OPENCODE" in
  hang) while :; do sleep 1; done ;;
  stubborn) trap "" TERM; while :; do sleep 1; done ;;
  fail) echo "boom" >&2; exit 1 ;;
  banner) echo "A new version of opencode is available: 9.9.9" ;;
esac
if [ "$days" = "0" ]; then cat "$here/../fixtures/opencode-stats.today.json"
else cat "$here/../fixtures/opencode-stats.week.json"; fi
